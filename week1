function makePixelCanvas(xOffset, yOffset, width, length) {
  for(y=0; y<width; y++) {
    for(x=0; x<length; x++) {
      strokeWeight(1);
      fill(255);
      square(x*5+xOffset, y*5+yOffset, 5)
    }
  }
}
